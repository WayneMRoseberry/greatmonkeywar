{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "level-list.schema.json",
  "title": "Level list",
  "description": "The levels in play order (data/levels/levels.json). See docs/data-formats.md.",
  "type": "object",
  "required": ["formatVersion", "levels"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "formatVersion": { "const": 1 },
    "levels": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" }
    }
  }
}
