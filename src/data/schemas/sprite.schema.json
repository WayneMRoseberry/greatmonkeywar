{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sprite.schema.json",
  "title": "Sprite sheet",
  "description": "An image divided into frames, with named animations. Frames fitting inside the image is checked by validate.js. See docs/data-formats.md.",
  "type": "object",
  "required": ["formatVersion", "image", "frameWidth", "frameHeight", "pixelsPerTile", "animations"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "formatVersion": { "const": 1 },
    "image": { "type": "string", "pattern": "^[A-Za-z0-9_-]+(/[A-Za-z0-9_-]+)*\\.png$" },
    "frameWidth": { "type": "integer", "minimum": 1 },
    "frameHeight": { "type": "integer", "minimum": 1 },
    "pixelsPerTile": { "type": "number", "exclusiveMinimum": 0 },
    "animations": {
      "type": "object",
      "required": ["idle"],
      "propertyNames": { "pattern": "^[A-Za-z0-9_-]+$" },
      "properties": {
        "idle": { "$ref": "#/$defs/animation" }
      },
      "additionalProperties": { "$ref": "#/$defs/animation" }
    }
  },
  "$defs": {
    "animation": {
      "type": "object",
      "required": ["frames", "fps"],
      "additionalProperties": false,
      "properties": {
        "frames": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 0 } },
        "fps": { "type": "number", "exclusiveMinimum": 0 },
        "loop": { "type": "boolean", "default": true }
      }
    }
  }
}
